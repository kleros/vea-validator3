# Copy to .env and fill in. Every value can also be passed as an env var.

# Route: arb-sepolia-to-sepolia-testnet | arb-sepolia-to-sepolia-devnet |
#        arb-sepolia-to-chiado-testnet  | arb-sepolia-to-chiado-devnet
# or set VEA_ROUTE_FILE=/path/to/custom-route.toml
VEA_ROUTE=arb-sepolia-to-sepolia-testnet

# Deadline-critical lane: signs challenge txs. MUST be a plain EOA.
# Needs deposit (1 ETH on the testnet route) + gas on the outbox chain.
VEA_CHALLENGE_PRIVATE_KEY=

# Slow lane: sendSnapshot (Arbitrum), L2->L1 execution (L1), withdraw (outbox chain).
# Optional but recommended: keeps slow txs from blocking a challenge by nonce.
VEA_OPS_PRIVATE_KEY=

# Comma-separated RPC overrides (all optional; sane public defaults built in).
# Use at least two independent providers per chain: verdicts require agreement.
#VEA_INBOX_RPC_URLS=https://sepolia-rollup.arbitrum.io/rpc,https://arbitrum-sepolia-rpc.publicnode.com
#VEA_OUTBOX_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org
#VEA_L1_RPC_URLS=

# Detect and alert, but never send transactions.
#VEA_DRY_RUN=true

# Challenge even when the verdict is ambiguous at the deadline (RPC quorum split).
# A wrong challenge forfeits the ENTIRE deposit. Default: alert only.
#VEA_CHALLENGE_ON_AMBIGUITY=false

# Wei reserved for gas, never spent on deposits.
#VEA_GAS_RESERVE_WEI=10000000000000000

# Slack/Discord-compatible webhook for alerts.
#VEA_WEBHOOK_URL=

#VEA_POLL_INTERVAL=30
# Default: ./vea-challenger-<route>.db. The Docker image sets /data/vea-challenger.db;
# a path outside /data there is lost when the container is recreated.
#VEA_DB_PATH=vea-challenger.db
#VEA_LOG_JSON=false
